{
  "compilerOptions": {
    /* Vite/esbuild transpile the app; tsc is only the type checker (noEmit). */
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    /* Keep the original strictness. `useDefineForClassFields` stays off because
       target < ES2022, matching the pre-migration class-field semantics. */
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* src/config.json is imported with named bindings, supported by Vite. */
    "resolveJsonModule": true,

    /* Vite/rolldown ship declarations that reference @types/node and a newer lib
       than a plain browser app needs. Only third-party .d.ts errors are silenced;
       `src/` is still fully checked, and deliberately not installing @types/node
       keeps Node globals (process/Buffer) undefined inside browser code. */
    "skipLibCheck": true
  },
  "include": ["src", "vite.config.mts"]
}
