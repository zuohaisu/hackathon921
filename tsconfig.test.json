{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* The agent tests run in a plain Node process, so this compile stays CJS.
       `moduleResolution: bundler` is only valid with ESNext modules, hence the
       reset to `node` here. */
    "outDir": ".test-build",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2017",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "src/agent/GameActions.ts",
    "src/agent/GameLoop.ts",
    "src/agent/types.ts",
    "src/entities/towers/towerTypes.ts"
  ]
}
