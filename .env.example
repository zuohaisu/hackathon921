# Agent proxy (issue #22). Copy to .env for local development — never commit a real key.
#
# Ops sets DEEPSEEK_API_KEY in the systemd EnvironmentFile on the server.
# The proxy reads it from the environment; it is never sent to the browser.
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Local development defaults (the proxy binds 127.0.0.1 only; nginx terminates TLS).
AGENT_PROXY_PORT=8787
AGENT_PROXY_HOST=127.0.0.1

# Set to the dev frontend origin (e.g. http://localhost:1234) so the browser can
# call the proxy cross-origin while developing. Leave empty in production, where
# nginx serves the app and the proxy under the same origin.
AGENT_PROXY_ALLOWED_ORIGIN=
